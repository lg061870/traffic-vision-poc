{
  "PassengerVision": {
    "ModelPath": "../../models/bus-passengers-rfdetr-s-v1.onnx",
    "ConfidenceThreshold": 0.40,
    "ProcessingFps": 1,
    "InitialPassengers": 0,
    "Classes": [
      { "ClassId": 0, "Name": "sitting", "OutputIndex": 1 },
      { "ClassId": 1, "Name": "standing", "OutputIndex": 2 }
    ],
    "Tracking": {
      "MatchIouThreshold": 0.30,
      "ConfirmAfterDetections": 3,
      "LostTrackFrames": 30
    },
    "DoorEvents": {
      "DefaultLineY": 0.70,
      "DefaultInsideSide": "above",
      "HysteresisPixels": 20,
      "StableFrames": 3,
      "CooldownSeconds": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
