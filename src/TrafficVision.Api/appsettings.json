{
  "PassengerVision": {
    "ModelPath": "../../models/bus-passengers-rfdetr-s-v1.onnx",
    "ConfidenceThreshold": 0.40,
    "ProcessingFps": 15,
    "InitialPassengers": 0,
    "ClassNames": [ "sitting", "standing" ],
    "Tracking": {
      "MatchIouThreshold": 0.30,
      "ConfirmAfterDetections": 3,
      "LostTrackFrames": 30
    },
    "DoorEvents": {
      "DefaultLineY": 0.70,
      "DefaultInsideSide": "above",
      "HysteresisPixels": 20,
      "StableFrames": 3,
      "CooldownSeconds": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
