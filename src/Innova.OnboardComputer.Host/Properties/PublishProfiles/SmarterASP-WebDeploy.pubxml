<?xml version="1.0" encoding="utf-8"?>
<!-- Web Deploy to the SmarterASP temp site "InnoOnboardComp" (site4). The password is not stored here:
     Visual Studio asks for it and keeps it in the .pubxml.user file next to this one. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://lg0618pp-002-site4.htempurl.com/health</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <!-- The shared app pool hosts other ASP.NET Core apps, so this one runs out-of-process too. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <MSDeployServiceURL>https://win1143.site4now.net:8172/msdeploy.axd?site=lg0618pp-002-site4</MSDeployServiceURL>
    <DeployIisAppPath>lg0618pp-002-site4</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>lg0618pp-002</UserName>
    <_SavePWD>true</_SavePWD>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
  </PropertyGroup>
</Project>
